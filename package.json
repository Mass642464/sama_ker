{
  "name": "geospacial-consulting",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/src/lib/properties.test.js .test-build/src/lib/public-properties.test.js .test-build/src/lib/geo.test.js .test-build/src/lib/pagination.test.js",
    "lint": "eslint",
    "backend:build": "npm run build --workspace=@sama-keur/backend",
    "backend:start": "npm run start --workspace=@sama-keur/backend",
    "backend:test": "npm run test --workspace=@sama-keur/backend"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "lucide-react": "^1.52.0",
    "next": "^16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
