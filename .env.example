NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Activer uniquement après migration, déploiement du backend et recette du parcours de visite.
NEXT_PUBLIC_VISIT_AGENDA_ENABLED=false
# Activer uniquement après déploiement, migration et recette de la fiche privée.
NEXT_PUBLIC_GEOSPATIAL_PROFILE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé Google Maps JavaScript API, restreinte aux domaines du site (référents HTTP) et à cette seule API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Identifiant de carte (Google Cloud) pour les repères avancés ; sans valeur, DEMO_MAP_ID est utilisé (développement).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
ADMIN_EMAILS=
